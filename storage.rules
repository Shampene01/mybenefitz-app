rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // PROFILE IMAGES
    // ============================================================
    // Users can read any profile image, but only write their own.
    // Path: profile-images/{userId}/profile.jpg
    match /profile-images/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // FICA DOCUMENTS
    // ============================================================
    // Users can only read/write their own FICA documents.
    // Max 5 MB, only images and PDFs.
    // Path: users/{userId}/fica/{file}
    match /users/{userId}/fica/{file} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // ============================================================
    // MEDIA CAMPAIGN IMAGES
    // ============================================================
    // Authenticated users can read campaign images.
    // Write access for admin use (tighten in production).
    match /media-campaigns/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
