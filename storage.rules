rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // PROFILE IMAGES
    // ============================================================
    // Users can read any profile image, but only write their own.
    // Path: profile-images/{userId}/profile.jpg
    match /profile-images/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // PROFILES: FICA & AFFILIATE DOCUMENTS
    // ============================================================
    // Users can only read/write their own documents.
    // Max 5 MB, only images and PDFs.
    // Path: profiles/{profileId}/fica/{file}
    match /profiles/{profileId}/fica/{file} {
      allow read: if request.auth != null && request.auth.uid == profileId;
      allow write: if request.auth != null
                   && request.auth.uid == profileId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Profile avatars stored with the rest of the profile folder
    // Path: profiles/{profileId}/avatar/{file}
    match /profiles/{profileId}/avatar/{file} {
      allow read: if request.auth != null; // show avatars across the app
      allow write: if request.auth != null
                   && request.auth.uid == profileId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Path: profiles/{profileId}/affiliate/{file}
    match /profiles/{profileId}/affiliate/{file} {
      allow read: if request.auth != null && request.auth.uid == profileId;
      allow write: if request.auth != null
                   && request.auth.uid == profileId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Path: profiles/{profileId}/loan-documents/{file}
    match /profiles/{profileId}/loan-documents/{file} {
      allow read: if request.auth != null && request.auth.uid == profileId;
      allow write: if request.auth != null
                   && request.auth.uid == profileId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // ============================================================
    // FINANCIAL PROFILE: INSURANCE POLICY DOCUMENTS
    // ============================================================
    // Users can upload policy documents for their insurance policies.
    // Path: profiles/{profileId}/financialProfile/insurance/{policyId}/{file}
    match /profiles/{profileId}/financialProfile/insurance/{policyId}/{file} {
      allow read: if request.auth != null && request.auth.uid == profileId;
      allow write: if request.auth != null
                   && request.auth.uid == profileId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // ============================================================
    // LEGACY: users/ storage (read-only for 90-day migration)
    // ============================================================
    match /users/{userId}/fica/{file} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /users/{userId}/affiliate/{file} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ============================================================
    // CREDIT REPORTS (private — owner-only read, backend writes)
    // ============================================================
    // Credit report PDFs are stored per-user under their profile folder.
    // The backend API posts reports here. Direct getDownloadURL tokens
    // are permanent and insecure. Access should go through the
    // getSecureDocumentUrl Cloud Function which generates short-lived
    // signed URLs after verifying ownership.
    // Path: profiles/{userId}/credit-reports/{file}
    match /profiles/{userId}/credit-reports/{file} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Backend writes via Admin SDK (bypasses rules)
    }

    // ============================================================
    // INSURER CERTIFICATES (admin-managed compliance docs)
    // ============================================================
    // Any authenticated user can read (shown on compliance page).
    // Only admin can upload (max 10 MB, images or PDFs).
    match /insurers/{insurerId}/certificates/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.auth.token.role == 'admin'
                       || request.auth.token.email == 'shampene@lebonconsulting.co.za')
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // ============================================================
    // MEDIA CAMPAIGN IMAGES
    // ============================================================
    // Authenticated users can read campaign images.
    // Write access for admin use (tighten in production).
    match /media-campaigns/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
