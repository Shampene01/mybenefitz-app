rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Check if authenticated user matches a given uid
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Check if the user has the admin role via custom claims OR is the platform owner
    function isAdmin() {
      return isAuth()
        && (request.auth.token.role == 'admin'
            || request.auth.token.email == 'shampene@lebonconsulting.co.za');
    }

    // Check if parent document's uid field references the current user
    // Supports both new 'profiles' and legacy 'users' document reference paths
    function parentOwnedByUser(parentPath) {
      return isAuth()
        && (get(parentPath).data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || get(parentPath).data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Check if user's email is verified
    function isVerified() {
      return isAuth() && request.auth.token.email_verified == true;
    }

    // Validate that incoming data has the required updatedAt timestamp
    function hasTimestamp() {
      return request.resource.data.keys().hasAll(['updatedAt']);
    }

    // Check if profile is Home Affairs verified (fields are locked)
    function isHomeAffairsVerified(profile) {
      return profile.data.keys().hasAll(['identityVerification']) 
        && profile.data.identityVerification.status == 'home_affairs_verified';
    }

    // Check if update affects locked fields (idNumber, firstName, lastName, dateOfBirth)
    function affectsLockedFields(resource, request) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['idNumber', 'firstName', 'lastName', 'dateOfBirth']);
    }

    // Case-insensitive email comparison between Firestore doc and auth token
    function emailMatches(docEmail) {
      return isAuth()
        && request.auth.token.email != null
        && docEmail.lower() == request.auth.token.email.lower();
    }

    // ============================================================
    // CONTACTS (WhatsApp / partner channel profiles)
    // ============================================================
    // Server-side Cloud Functions and admin users manage contacts.
    // Linked portal users can read their own contact record.
    match /contacts/{contactId} {
      // Read: admin, already-linked verified user, OR verified user whose email matches
      allow read: if isAdmin()
        || (isVerified() && resource.data.linkedUserId == request.auth.uid)
        || (isVerified() && emailMatches(resource.data.email));
      allow create: if isAdmin();
      // Update: admin can do anything; verified user can ONLY set
      // linkedUserId (to their own uid) and linkingStrategy — and only if
      // the contact email matches their verified email.
      allow update: if isAdmin()
        || (isVerified()
            && emailMatches(resource.data.email)
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['linkedUserId', 'linkingStrategy'])
            && request.resource.data.linkedUserId == request.auth.uid);
      allow delete: if false;

      // Consents subcollection
      match /consents/{consentId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // ============================================================
    // CLIENT PRODUCTS (WhatsApp-originated product applications)
    // ============================================================
    // Linked portal users can read their own products via email match.
    // Admin and Cloud Functions manage writes.
    match /clientProducts/{productId} {
      allow read: if isAdmin()
        || (isVerified() && emailMatches(resource.data.email));
      allow create: if isAdmin()
        || (isVerified() && emailMatches(request.resource.data.email));
      allow update: if isAdmin()
        || (isVerified() && emailMatches(resource.data.email));
      allow delete: if false;
    }

    // ============================================================
    // PAYMENT LINKS (WhatsApp payment links)
    // ============================================================
    match /paymentLinks/{linkId} {
      allow read: if isAdmin()
        || (isVerified() && emailMatches(resource.data.email));
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // MEDIA CAMPAIGNS (public content)
    // ============================================================
    // Used by the CampaignCarousel on the mobile app dashboard.
    // Reads: any authenticated user
    // Writes: admin only
    match /mediaCampaigns/{campaignId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // PROFILES (unified collection — replaces users + contacts)
    // ============================================================
    // Owner can create, read, and update their own document.
    // Users cannot delete their own profile (admin/backend only).
    // Admins can read any profile.
    // Locked fields (idNumber, firstName, lastName, dateOfBirth) cannot be updated
    // after Home Affairs verification.
    match /profiles/{profileId} {
      allow create: if isOwner(profileId) || isAdmin();
      allow read: if isOwner(profileId) || isAdmin();
      
      // Update: admins can update anything; owners can update if not verified OR not changing locked fields
      allow update: if isAdmin()
        || (isOwner(profileId)
            && (
              // Not verified — allow all updates
              !isHomeAffairsVerified(resource)
              // Verified — only block if locked fields are actually CHANGED (not just included)
              || !affectsLockedFields(resource, request)
            )
        );
      
      allow delete: if false;

      // Consents subcollection
      match /consents/{consentId} {
        allow read: if isOwner(profileId) || isAdmin();
        allow create: if isOwner(profileId) || isAdmin();
        allow update: if isAdmin();
        allow delete: if false;
      }

      // Intermediary Appointments (subcollection)
      match /intermediaryAppointment/{document} {
        allow create: if isOwner(profileId);
        allow read: if isOwner(profileId) || isAdmin();
        allow update: if isOwner(profileId);
        allow delete: if isOwner(profileId);
      }

      // Short-Term Policies (subcollection)
      match /shortTermPolicies/{document} {
        allow create: if isOwner(profileId);
        allow read: if isOwner(profileId) || isAdmin();
        allow update: if isOwner(profileId);
        allow delete: if isOwner(profileId);
      }

      // Product Applications subcollection (Phase 1 dual-write migration)
      // Each application gets its own document — no overwrites, full audit trail
      match /productApplications/{applicationId} {
        allow read: if isOwner(profileId) || isAdmin();
        allow create: if isOwner(profileId) || isAdmin();
        allow update: if isOwner(profileId) || isAdmin();
        // No delete — applications are immutable for audit
        allow delete: if false;
      }

      // Financial Profile (FNA — progressive financial profiling)
      // Covers all documents and nested subcollections:
      //   financialProfile/{doc}                  — overview, income, expenses, goals, etc.
      //   financialProfile/{doc}/{sub}/{item}      — assets/properties, liabilities/debts, etc.
      //   financialProfile/{doc}/{sub}/{item}/...  — audit/fnaSnapshots, etc.
      match /financialProfile/{document=**} {
        allow read: if isOwner(profileId) || isAdmin();
        allow create, update: if isOwner(profileId);
        allow delete: if isOwner(profileId);
      }
    }

    // ============================================================
    // LEGACY: USER PROFILES (read-only for 90-day migration)
    // ============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Collection group query for intermediaryAppointment
    match /{path=**}/intermediaryAppointment/{document} {
      allow read: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
    }

    // ============================================================
    // LOAN CUSTOMERS
    // ============================================================
    match /LoanCustomer/{customerId} {
      allow create: if isAuth()
        && (request.resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || request.resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow read: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if false;

      // Affordability Assessment (subcollection)
      match /AffordabilityAssessment/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow delete: if false;
      }

      // Loan Application (subcollection)
      match /LoanApplication/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow delete: if false;
      }

      // Loan Repayment (subcollection)
      match /LoanRepayment/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow delete: if false;
      }

      // Loan Documents (subcollection)
      match /loanDocuments/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/LoanCustomer/$(customerId));
        allow delete: if false;
      }
    }

    // ============================================================
    // LOANS (standalone collection)
    // ============================================================
    match /loan/{document} {
      allow create: if isAuth()
        && (request.resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || request.resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow read: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if false;
    }

    // ============================================================
    // POLICIES
    // ============================================================
    match /policy/{policyId} {
      allow create: if isAuth()
        && (request.resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || request.resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow read: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isAuth()
        && (resource.data.uid == /databases/$(database)/documents/profiles/$(request.auth.uid)
            || resource.data.uid == /databases/$(database)/documents/users/$(request.auth.uid));
      allow delete: if false;

      // OTP Signature (subcollection)
      match /OTPSignature/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow delete: if false;
      }

      // Replacement Details (subcollection)
      match /ReplacementDetails/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow delete: if false;
      }

      // Banking Details (subcollection)
      match /banking_details/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow delete: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
      }

      // Beneficiary (subcollection)
      match /beneficiary/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow delete: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
      }

      // Dependent (subcollection)
      match /dependent/{document} {
        allow create: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow read: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow update: if parentOwnedByUser(/databases/$(database)/documents/policy/$(policyId));
        allow delete: if false;
      }
    }

    // ============================================================
    // CONVERSATIONS (WhatsApp audit — admin/backend only)
    // ============================================================
    match /conversations/{conversationId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin();
        allow write: if false; // Cloud Functions only
        allow delete: if false;
      }
    }

    // ============================================================
    // AFFILIATE APPLICATIONS (user creates own, admin reads all)
    // ============================================================
    match /affiliateApplications/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // EVENTS (webhook audit log — backend only)
    // ============================================================
    match /events/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
      allow delete: if false;
    }

    // ============================================================
    // LINKING AUDIT LOG (tracks contact→user link events)
    // ============================================================
    match /linkingAuditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isVerified();
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // INSURERS (public product/insurer data — admin-managed)
    // ============================================================
    // Any authenticated user can read insurer info (shown on product pages).
    // Only admin (shampene@lebonconsulting.co.za or role=admin) can write.
    match /insurers/{insurerId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Certificates subcollection (FSB licences, compliance docs, etc.)
      match /certificates/{certId} {
        allow read: if isAuth();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // PLATFORM DOCUMENTS (fund fact sheets, disclosures — admin-managed)
    // ============================================================
    match /platformDocuments/{docId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // CAMPAIGNS (promotional banners & campaigns — admin-managed)
    // ============================================================
    match /campaigns/{campaignId} {
      allow read: if isAuth();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // SUPPORT TICKETS (user creates & reads own, admin manages all)
    // ============================================================
    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuth() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATION PREFERENCES (coming-soon product interest capture)
    // ============================================================
    match /notificationPreferences/{prefId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS (legacy — system-generated, user reads own)
    // ============================================================
    match /notifications/{notifId} {
      allow read: if isAuth()
        && resource.data.uid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // CLIENT NOTIFICATIONS (backend-generated, user reads & marks read)
    // ============================================================
    match /clientNotifications/{notifId} {
      allow read: if isAuth()
        && resource.data.uid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // DEFAULT DENY — all unmatched paths are blocked
    // ============================================================
  }
}
