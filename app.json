{
  "expo": {
    "name": "MyBenefitz",
    "slug": "mybenefitz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mybenefitz",
    "facebookScheme": "fb1993100858285396",
    "facebookAppId": "1993100858285396",
    "facebookDisplayName": "MyBenefitz",
    "facebookAutoInitEnabled": true,
    "facebookAutoLogAppEventsEnabled": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.za.mybenefitz.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MyBenefitz needs access to your camera to take photos of FICA documents.",
        "NSPhotoLibraryUsageDescription": "MyBenefitz needs access to your photo library to upload FICA documents.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "co.za.mybenefitz.app",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6ea5dfe8-e770-4e9e-addc-cf38559e67e9"
      },
      "socialAuth": {
        "googleExpoClientId": "867203198671-eb938cul0fjn0eq22n86ekv29a6i0bmm.apps.googleusercontent.com",
        "googleIosClientId": "867203198671-b6ch634tpd9qmop5hmo811porcfrmemt.apps.googleusercontent.com",
        "googleAndroidClientId": "867203198671-nipt7n6vmpp0sod0rekkuanbhc5dtlvg.apps.googleusercontent.com",
        "googleWebClientId": "867203198671-eb938cul0fjn0eq22n86ekv29a6i0bmm.apps.googleusercontent.com",
        "facebookAppId": "1993100858285396"
      }
    },
    "owner": "shampene01"
  }
}
